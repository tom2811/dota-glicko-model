# PandaScore API (for /live endpoint only)
PANDASCORE_API_KEY=your_api_key_here
PANDASCORE_BASE_URL=https://api.pandascore.co

# Liquipedia API (for /upcoming endpoint - no key needed)
LIQUIPEDIA_API_URL=https://dota.haglund.dev/v1/matches

# Caching
CACHE_TTL_UPCOMING=300  # 5 minutes
CACHE_TTL_LIVE=60       # 1 minute
ROSTER_CACHE_TTL=604800 # 7 days (for scraped rosters)

# Web scraping
LIQUIPEDIA_BASE_URL=https://liquipedia.net/dota2
SCRAPER_USER_AGENT=DotaGlickoPredictor/1.0 (Educational Project)
SCRAPER_RATE_LIMIT=2  # seconds between requests
